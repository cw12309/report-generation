EMBED_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=embedding-service-api-key

CHAT_URL=http://chat-service-host:port/v1
CHAT_MODEL=chat-model-name
CHAT_API_KEY=chat-service-api-key

RERANK_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3
SILICONFLOW_API_KEY=rerank-service-api-key

MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=

API_SECRET_KEY=gateway-bearer-token

# Report LLM Prompt Trace（默认仅关闭；FULL 仅在调试环境按需开启）
PROMPT_TRACE_ENABLED=false
PROMPT_TRACE_FULL=false

PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
